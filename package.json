{
	"name": "shopping-list-ui",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"start": "vite --open",
		"build": "vite build",
		"test": "vitest",
		"lint:local": "biome check --reporter=concise",
		"lint:fix": "biome check --write",
		"lint": "biome ci",
		"preview": "vite preview",
		"knip": "knip",
		"typecheck": "tsc --noEmit",
		"install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
		"dependencies:ci": "npx depcruise src  --include-only \"^src\"",
		"dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
		"dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
		"prepare": "husky"
	},
	"dependencies": {
		"@bbrighter/auth-module": "^2.3.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^9.2.0",
		"@mui/material": "^9.2.0",
		"jotai": "^2.20.2",
		"jotai-family": "^1.0.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-swipeable-list": "^1.10.0",
		"sonner": "^2.0.7",
		"wouter": "^3.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^25.9.5",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.10",
		"dependency-cruiser": "^17.4.3",
		"husky": "^9.1.7",
		"jsdom": "^29.1.1",
		"knip": "^6.27.0",
		"msw": "^2.15.0",
		"rollup-plugin-visualizer": "^7.0.1",
		"typescript": "~6.0.3",
		"vite": "^8.1.5",
		"vite-plugin-checker": "^0.14.4",
		"vitest": "^4.1.10"
	}
}
