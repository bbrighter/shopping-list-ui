{
  "name": "shopping-list-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && tsc",
    "preview": "vite preview",
    "knip": "knip",
    "tsc": "tsc",
    "install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
    "dependencies:ci": "npx depcruise src  --include-only \"^src\"",
    "dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
    "prepare": "husky"
  },
  "dependencies": {
    "@bbrighter/auth-module": "^2.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "dependency-cruiser": "^17.3.6",
    "jotai": "^2.16.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-swipeable-list": "^1.10.0",
    "sonner": "^2.0.7",
    "wouter": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@stylistic/eslint-plugin": "^5.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.17",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^5.82.1",
    "msw": "^2.12.7",
    "rolldown-vite": "^7.3.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.53.1",
    "vite": "7.3.0",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.0"
  }
}