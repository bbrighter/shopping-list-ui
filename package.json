{
  "name": "shopping-list-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && tsc",
    "preview": "vite preview",
    "knip": "knip",
    "tsc": "tsc",
    "install:local-package": "pnpm install ../auth-module/bbrighter-auth-module-0.1.1.tgz --no-cache",
    "dependencies:ci": "npx depcruise src  --include-only \"^src\"",
    "dependencies:table": "npx depcruise src  --include-only \"^src\" --output-type html > graph.html",
    "dependencies:graph": "npx depcruise --include-only \"^src\" --output-type dot src | dot -T svg > graph.svg",
    "prepare": "husky"
  },
  "dependencies": {
    "@bbrighter/auth-module": "^2.3.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "dependency-cruiser": "^17.4.2",
    "jotai": "^2.20.0",
    "jotai-family": "^1.0.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-swipeable-list": "^1.10.0",
    "sonner": "^2.0.7",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "10",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "13",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.14.2",
    "msw": "^2.14.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.14",
    "vite-plugin-checker": "^0.14.1",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.3.0",
    "eslint-plugin-react": {
      "eslint": ">=9"
    }
  }
}